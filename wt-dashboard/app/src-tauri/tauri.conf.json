{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wt-dashboard",
  "version": "0.1.0",
  "identifier": "id.local.wtdashboard",
  "build": { "frontendDist": "../../web/dist" },
  "app": { "withGlobalTauri": true, "windows": [], "security": { "csp": null } },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/wt-dashboard-server"],
    "resources": { "../../web/dist/": "web/" }
  }
}
