#!/bin/sh
# wt-pack setup: one command from a fresh clone to a working pack.
#
#   ./setup [install] [--yes] [--no-secrets] [--no-service]   # idempotent; ends with doctor
#   ./setup doctor [--no-service] [--fix]                     # one line per need; exit 1 if a required one fails
#                                                              # --fix: apply doctor's own safe repairs (below)
#   ./setup secrets                                           # optional keys (TypeSafe; Linear via the dashboard)
#   ./setup plugin                                            # just the plugin step (WP-213): load this checkout as the one wt-pack plugin
#   ./setup uninstall [--purge] [--yes]                       # links, plugin, service; keeps data unless --purge
#
# Never installs without asking: missing Homebrew packages are listed and installed after one y/N (--yes skips
# it); a missing Homebrew or herdr is a printed hint, never a piped installer. Anything that already points at
# ANOTHER wt-pack checkout (a skill link, the plugin marketplace, the launchd service) is reported and kept, so
# running this from a worktree never repoints the live install. macOS-first; Linux gaps are printed by doctor.
set -u

REPO=$(cd "$(dirname "$0")" && pwd -P)
SKILLS="$HOME/.claude/skills"
SK="$REPO/skills"
DASH="$SK/wt-dashboard"
WP="$SK/wt-watch-prs"
PLIST="$HOME/Library/LaunchAgents/id.local.wtdashboard.server.plist"
WPPLIST="$HOME/Library/LaunchAgents/id.local.wtpack.watchprs.plist"
WPUNIT="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/wt-watch-prs.service"  # WP-190: Linux twin of WPPLIST
PORT=${PORT:-7777}
OS=$(uname -s)

cmd=install; yes=0; secrets=1; service=1; purge=0; fix=0
for a in "$@"; do
  case "$a" in
    install|doctor|uninstall|secrets|plugin|plugin-check) cmd=$a ;;
    --yes|-y) yes=1 ;;
    --no-secrets) secrets=0 ;;
    --no-service) service=0 ;;
    --purge) purge=1 ;;
    --fix) fix=1 ;;
    -h|--help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "setup: unknown argument: $a (see ./setup --help)" >&2; exit 2 ;;
  esac
done

ok()   { printf '  \342\234\223 %s\n' "$*"; }          # ✓
bad()  { printf '  \342\234\227 %s\n' "$*"; fails=$((fails + 1)); }  # ✗ (required)
opt()  { printf '  \342\200\223 %s\n' "$*"; }          # – (optional / note)
step() { printf '%s\n' "$*"; }
has()  { command -v "$1" >/dev/null 2>&1; }
ask()  { [ "$yes" -eq 1 ] && return 0; [ -t 0 ] || return 1; printf '%s [y/N] ' "$1"; read -r r; [ "$r" = y ] || [ "$r" = Y ]; }
fails=0

# WP-107: each project with a GitHub account (dashboard Settings › Projects): gh has a token for it, the token logs in
# as that account (not another one stored under its name), and it reaches the project's repo (when its checkout is known:
# WT_DASHBOARD_REPO / WT_DASHBOARD_PROJECTS, or this checkout).
gh_accounts() {
  accts=$(node "$SK/wt-shared/scripts/project-setting.mjs" list-accounts 2>/dev/null)
  [ -n "$accts" ] || return 0
  while IFS="$(printf '\t')" read -r proj acct; do
    [ -n "$acct" ] || continue
    if ! tok=$(gh auth token --user "$acct" 2>/dev/null) || [ -z "$tok" ]; then bad "$proj: no gh token for $acct — gh auth login (as $acct)"; continue; fi
    login=$(GH_TOKEN=$tok gh api user -q .login 2>/dev/null)
    [ "$login" = "$acct" ] || { bad "$proj: the token stored for $acct logs in as '${login:-nothing}'"; continue; }
    dir=
    # one path per line, not word-split: a checkout path may hold spaces (WP-214)
    dirs=$(printf '%s\n' "$REPO"; sed -nE 's/^[[:space:]]*(export[[:space:]]+)?WT_DASHBOARD_(REPO|PROJECTS)=//p' "$HOME/.config/wt-dashboard/env" 2>/dev/null | tr -d "\"'" | tr ':' '\n')
    while IFS= read -r d; do
      [ -n "$d" ] || continue
      top=$(dirname "$(git -C "$d" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" 2>/dev/null)
      [ "$(basename "$top")" = "$proj" ] && { dir=$top; break; }
    done <<DIRS
$dirs
DIRS
    if [ -z "$dir" ]; then ok "$proj: gh account $acct (repo not checked: checkout unknown)"
    elif (cd "$dir" && GH_TOKEN=$tok gh repo view --json name >/dev/null 2>&1); then ok "$proj: gh account $acct reaches its repo"
    else bad "$proj: $acct cannot reach the repo of $dir"; fi
  done <<EOF
$accts
EOF
}

# A wt-pack checkout: a directory with the pack's marketplace manifest.
is_pack() { [ -f "$1/.claude-plugin/marketplace.json" ] && grep -q '"name": *"wt-pack"' "$1/.claude-plugin/marketplace.json"; }
# The checkout a skill dir belongs to: <co>/skills/<s> (this layout) or <co>/<s> (before WP-69).
root_of() { d=$(dirname "$1"); if [ "$(basename "$d")" = skills ]; then dirname "$d"; else echo "$d"; fi; }
# A checkout's dir for skill $2, in whichever layout it has.
skill_dir() { if [ -d "$1/skills/$2" ]; then echo "$1/skills/$2"; else echo "$1/$2"; fi; }
node_ok() { has node && node -e 'const [a,b]=process.versions.node.split(".").map(Number);process.exit(a>22||(a===22&&b>=13)?0:1)'; }
service_root() { [ -f "$PLIST" ] && plutil -extract ProgramArguments.1 raw "$PLIST" 2>/dev/null | sed 's#/server.mjs$##'; }
wpservice_root() {
  # WP-191: the service runs a shim that names the checkout; older installs pointed at watch-prs.sh directly.
  local shim="${WT_WATCH_PRS_HOME:-$HOME/.local/share/wt-watch-prs}/bin/watch-prs"
  if [ -f "$shim" ] && { [ -f "$WPPLIST" ] || [ -f "$WPUNIT" ] || [ -f "$(dirname "$(dirname "$shim")")/poller.pid" ]; }; then sed -n 's#^exec bash "\(.*\)/scripts/watch-prs\.sh" "\$@"$#\1#p' "$shim"; return; fi
  if [ "$OS" = Darwin ]; then [ -f "$WPPLIST" ] && plutil -extract ProgramArguments.1 raw "$WPPLIST" 2>/dev/null | sed 's#/scripts/watch-prs\.sh$##'
  else [ -f "$WPUNIT" ] && sed -n 's#^ExecStart=/bin/bash "\(.*\)/scripts/watch-prs\.sh" serve$#\1#p' "$WPUNIT"; fi
}
# have_systemd_user: a systemd user manager answers (false in containers and on non-systemd hosts).
have_systemd_user() { command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; }
# JSON via node (required anyway), not jq: a missing jq must not read as a missing plugin.
market_path() { claude plugin marketplace list --json 2>/dev/null | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{const m=JSON.parse(s).find(x=>x.name==="wt-pack");if(m)console.log(m.path||m.installLocation||"")}catch{}})'; }
# plugin_ver <id>: that plugin id's installed version — with no version pinned in plugin.json (WP-156),
# Claude Code computes it from the source's git commit, so this is a commit (prefix), not a semver string.
# checkout_commit <dir>: that dir's current HEAD commit, to compare it against.
plugin_ver() { claude plugin list --json 2>/dev/null | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{console.log(JSON.parse(s).find(p=>p.id===process.argv[1])?.version||"")}catch{}})' "$1"; }
checkout_commit() { git -C "$1" rev-parse HEAD 2>/dev/null; }
# plugin_current <short> <dir> <paths…> (WP-189): the installed plugin (version = the commit Claude Code installed
# from) is current when that commit is HEAD, or when nothing under <paths> differs between it and HEAD — a commit
# elsewhere in the repo does not change what the plugin ships. An unknown commit (not in this clone) is stale.
plugin_current() {
  local iv=$1 d=$2; shift 2
  [ -n "$iv" ] || return 1
  case "$(checkout_commit "$d")" in "$iv"*) return 0;; esac
  git -C "$d" cat-file -e "$iv^{commit}" 2>/dev/null && git -C "$d" diff --quiet "$iv" HEAD -- "$@" 2>/dev/null
}
# plugin_listed <id>: that plugin id is installed/loaded (any state).
plugin_listed() { claude plugin list --json 2>/dev/null | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{process.exit(JSON.parse(s).some(p=>p.id===process.argv[1])?0:1)}catch{process.exit(1)}})' "$1"; }
# Install hint for a missing package, for this OS.
# sudo only when needed: root (a container) often has no sudo at all.
SUDO=$([ "$(id -u)" -eq 0 ] && echo "" || echo "sudo ")
pkg() { if [ "$OS" = Darwin ]; then echo "brew install $1"; elif has apt-get; then echo "${SUDO}apt-get install -y $1"; elif has dnf; then echo "${SUDO}dnf install -y $1"; else echo "install $1 with your package manager"; fi; }
# herdr: report, never install. $1 = bad|opt (how a missing herdr counts); $2 = 1 also runs `herdr config check`.
herdr_check() {
  if ! has herdr; then
    $1 "herdr — needed for agents, handoffs and rooms; run: $(if has brew; then echo 'brew install herdr'; else echo 'curl -fsSL https://herdr.dev/install.sh | sh'; fi)"; return
  fi
  how="direct install, update: herdr update"; has brew && brew list herdr >/dev/null 2>&1 && how="Homebrew, update: brew upgrade herdr"
  ok "$(herdr --version 2>/dev/null | head -1) ($how)"
  case "$(herdr integration status 2>/dev/null | grep '^claude:')" in
    "claude: current"*) ok "herdr claude integration" ;;
    *) opt "herdr claude integration missing or outdated (agent state) — run: herdr integration install claude" ;;
  esac
  [ "${2:-0}" = 1 ] || return 0
  if herdr config check >/dev/null 2>&1; then ok "herdr config"; else opt "herdr config check reports problems — run: herdr config check"; fi
  # The dashboard reads agents from the herdr server; without one its Overview cannot load.
  if herdr status server 2>/dev/null | grep -q '^status: running'; then ok "herdr server running"; else opt "herdr server not running — start it with: herdr (the dashboard needs it for agents)"; fi
}
built() { [ -f "$DASH/web/dist/index.html" ] && [ -z "$(find "$DASH/web/src" "$DASH/web/index.html" "$DASH/web/package.json" -newer "$DASH/web/dist/index.html" 2>/dev/null | head -1)" ]; }

# ---------------------------------------------------------------- doctor
doctor() {
  fails=0
  step "wt-pack doctor ($REPO)"
  if node_ok; then ok "node $(node -v)"; else bad "node >= 22.13 (have: $(node -v 2>/dev/null || echo none)) — $(pkg node)"; fi
  if has node && node -e "process.getBuiltinModule('node:sqlite')" >/dev/null 2>&1; then ok "node:sqlite"; else bad "node:sqlite unavailable — node >= 22.13"; fi
  for c in git curl; do if has $c; then ok "$c"; elif [ "$OS" = Darwin ]; then bad "$c — xcode-select --install"; else bad "$c — $(pkg $c)"; fi; done
  if has jq; then ok "jq"; else bad "jq — $(pkg jq)"; fi
  if ! has gh; then bad "gh — $(pkg gh)"
  elif gh auth status >/dev/null 2>&1; then ok "gh (authenticated)"
  else bad "gh not logged in — run: gh auth login"; fi
  has gh && has node && gh_accounts
  herdr_check bad 1
  if has claude; then ok "claude"; else bad "claude (Claude Code) not on PATH"; fi

  grep -qs "$REPO/wt-shared/hooks/" "$HOME/.claude/settings.json" \
    && opt "~/.claude/settings.json runs a hook from $REPO/wt-shared/hooks (pre-WP-69 path) — change it to the plugin's hook path"
  plugin_check
  # WP-120: the PATH shim layer (wt-agents/bin, set at spawn) does not depend on the plugin cache.
  nm=0; ns=0
  for pid in $(pgrep -f 'claude .*--name ' 2>/dev/null); do
    e=$(ps eww -o command= -p "$pid" 2>/dev/null) || continue
    case "${e%% *}" in claude|*/claude) ;; *) continue ;; esac
    nm=$((nm + 1)); case "$e" in *WT_KILL_SHIM_DIR=*wt-agents/bin*) ;; *) ns=$((ns + 1)) ;; esac
  done
  if [ "$nm" -gt 0 ] && [ "$ns" -eq 0 ]; then ok "kill shim active in all $nm agent sessions"
  elif [ "$ns" -gt 0 ]; then opt "$ns of $nm agent sessions run without the pkill/pgrep/killall shim (spawned before WP-120) — wt-agents respawn --stale (in each repo)"; fi

  # WP-98: commits here use a GitHub noreply identity (repo-local git config), so no personal/work email ships.
  if git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1; then
    nr='(^|[+@])(users\.)?noreply\.github\.com$'
    me=$(git -C "$REPO" config user.email || true)
    other=$(git -C "$REPO" log -50 --format='%ae%n%ce' 2>/dev/null | grep -vEc "$nr" || true)
    if ! printf '%s' "$me" | grep -qE "$nr"; then opt "git user.email here is '${me:-unset}', not a users.noreply.github.com address — git -C \"$REPO\" config user.email <id>+<user>@users.noreply.github.com"
    elif [ "${other:-0}" -gt 0 ]; then opt "git: $other of the last 50 author/committer emails are not GitHub noreply addresses — check git -C \"$REPO\" log -50 --format='%ae %ce'"
    else ok "git identity: GitHub noreply ($me)"; fi
  fi

  if [ -f "$DASH/web/dist/index.html" ]; then
    if built; then ok "dashboard web built"; else opt "dashboard web built, but older than web/src — npm --prefix skills/wt-dashboard run build"; fi
  else bad "dashboard web not built — ./setup install"; fi

  if [ "$service" -eq 0 ]; then opt "service not checked (--no-service)"
  elif [ "$OS" = Darwin ]; then
    root=$(service_root)
    if [ -z "$root" ]; then bad "launchd service not installed — ./setup install"
    else
      st=$(node "$DASH/scripts/service.mjs" status 2>/dev/null | head -1)
      case "$st" in
        *": running"*) ok "service ${st%%,*}${root:+ — runs $root}" ;;
        *) bad "service: ${st:-unknown} — node $DASH/scripts/service.mjs install" ;;
      esac
    fi
  else
    opt "no launchd on $OS: run the dashboard with  npm --prefix $DASH start  (a systemd user unit is not provided)"
  fi

  # WP-187: optional — SKILL.md's §1 arms Monitors instead when this isn't running, so a failure here is a
  # note, not a required check (never `bad`).
  if [ "$service" -eq 0 ]; then opt "watchprs poller not checked (--no-service)"
  else
    wpst=$("$WP/scripts/watch-prs.sh" poller-status 2>&1)
    case "$wpst" in
      *"(stale)"*) opt "watchprs $wpst — node $WP/scripts/poller-service.mjs restart" ;;
      *"loaded, beat"*) opt "watchprs $wpst" ;;
      *) opt "watchprs $wpst — node $WP/scripts/poller-service.mjs install (optional: SKILL.md falls back to Monitors without it)" ;;
    esac
  fi
  code=$(curl -s -o /dev/null -m 3 -w '%{http_code}' "http://127.0.0.1:$PORT/" 2>/dev/null)
  case "$code" in 2*|3*|401|403) ok "dashboard answers on http://127.0.0.1:$PORT ($code)" ;;
    *) if [ "$OS" = Darwin ]; then bad "dashboard not answering on 127.0.0.1:$PORT (http ${code:-none})"; else opt "dashboard not running on 127.0.0.1:$PORT"; fi ;; esac
  # WP-80: the bind address (this shell, or the systemd unit from docs/vm.md). Loopback is the only safe default.
  unit="$HOME/.config/systemd/user/wt-dashboard.service"
  bind=${WT_DASHBOARD_HOST:-$( [ -f "$unit" ] && sed -n 's/^Environment=WT_DASHBOARD_HOST=//p' "$unit" | head -1 )}
  case "${bind:-127.0.0.1}" in
    127.0.0.1|::1|localhost) ok "dashboard binds loopback (${bind:-127.0.0.1}); reach it remotely with Tailscale or ssh -L, see docs/vm.md" ;;
    *) opt "dashboard bind WT_DASHBOARD_HOST=$bind is not loopback — the server refuses it without WT_ALLOW_REMOTE=1; prefer Tailscale or ssh -L (docs/vm.md)" ;;
  esac

  [ -f "$HOME/.config/wt-dashboard/env" ] && ok "config ~/.config/wt-dashboard/env" || opt "no ~/.config/wt-dashboard/env yet (./setup install creates it)"
  [ -d "$HOME/.config/wt-memory" ] && ok "memory store ~/.config/wt-memory" || opt "no ~/.config/wt-memory yet (./setup install creates it)"

  # optional
  if [ -n "${TYPESAFE_API_KEY:-}" ] || grep -qs '^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}TYPESAFE_API_KEY=' "$HOME/.claude/.env" \
     || { has security && security find-generic-password -s wt-dashboard -a TYPESAFE_API_KEY >/dev/null 2>&1; }; then ok "TypeSafe key (optional)"
  else opt "TypeSafe key not set (optional: ./setup secrets)"; fi
  if has security && security find-generic-password -s wt-dashboard -a LINEAR_API_KEY >/dev/null 2>&1; then ok "Linear key (optional)"
  else opt "Linear key not set (optional: dashboard Settings › Integrations)"; fi
  # WP-136: a stale ~/.claude/.env key is used ahead of a rotated Keychain one nowhere any more (typesafe.mjs
  # checks env, then Keychain, then the .env file). WP-171 then had doctor remove the file copy on sight
  # whenever it disagreed with the Keychain — but doctor is a health check, run unattended and often, and the
  # file copy could be the NEWER key (someone rotated it there and hasn't gotten to the Keychain yet); doctor
  # has no way to tell which side is actually stale. WP-180: report-only by default, same as every other check
  # here. `--fix` performs the same removal WP-171 did, but backs the file up first (0600, timestamped, never
  # touched again by doctor) and names what it removed, never the value.
  if has security; then
    envkey=$(sed -n 's/^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}TYPESAFE_API_KEY=//p' "$HOME/.claude/.env" 2>/dev/null | tail -1 | tr -d '"'"'"'')
    keykey=$(security find-generic-password -s wt-dashboard -a TYPESAFE_API_KEY -w 2>/dev/null)
    if [ -n "$envkey" ] && [ -n "$keykey" ] && [ "$envkey" != "$keykey" ]; then
      if [ "$fix" -eq 1 ]; then
        bak="$HOME/.claude/.env.bak-$(date +%Y%m%d%H%M%S)"
        if cp -p "$HOME/.claude/.env" "$bak" && chmod 600 "$bak"; then
          # grep -v exits 1 (not an error) when every line is filtered out, e.g. this was the file's only
          # line — gate on mv/chmod succeeding, not on grep's exit status.
          tmp="$HOME/.claude/.env.tmp.$$"
          grep -v '^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}TYPESAFE_API_KEY=' "$HOME/.claude/.env" > "$tmp" 2>/dev/null
          if mv "$tmp" "$HOME/.claude/.env" && chmod 600 "$HOME/.claude/.env"; then
            opt "TypeSafe key: removed the TYPESAFE_API_KEY line from ~/.claude/.env (backed up to $bak) — the Keychain entry is kept"
          else
            rm -f "$tmp"
            opt "TypeSafe key mismatch: --fix couldn't rewrite ~/.claude/.env (backup at $bak) — rotate whichever copy is stale by hand"
          fi
        else
          opt "TypeSafe key mismatch: --fix couldn't back up ~/.claude/.env, left both copies alone — rotate whichever is stale by hand"
        fi
      else
        opt "TypeSafe key mismatch: ~/.claude/.env and the wt-dashboard Keychain entry hold different values — ./setup doctor --fix removes the file copy (backed up first), or rotate whichever is stale by hand"
      fi
    fi
  fi
  has tailscale && ok "tailscale (optional, remote access)" || opt "tailscale not installed (optional, remote access)"
  has agent-browser && ok "agent-browser (optional, preferred for browser checks)" || opt "agent-browser not installed (optional, preferred for browser checks): npm i -g agent-browser && agent-browser install"
  has ccusage && ok "ccusage (optional, Usage live block)" || opt "ccusage not installed (optional, Usage live block): npm i -g ccusage"
  has cargo && ok "cargo (optional, Tauri app)" || opt "cargo not installed (optional, only for the Tauri app)"
  for c in codex gemini; do has $c && opt "$c found: wt-memory hookup is manual, see skills/wt-memory/SKILL.md"; done
  [ "$OS" = Darwin ] || opt "Linux: no launchd, no Keychain (keys go in ~/.config/wt-dashboard/env), no brew prompt (apt: nodejs jq gh git curl), no Tauri app"

  if [ "$fails" -eq 0 ]; then step "doctor: all required checks pass"; return 0; fi
  step "doctor: $fails required check(s) failing"; return 1
}

# ---------------------------------------------------------------- install
deps() {
  step "dependencies"
  want=""
  node_ok || want="$want node"
  has jq || want="$want jq"
  has gh || want="$want gh"
  has git || want="$want git"
  has curl || want="$want curl"
  herdr_check opt
  if [ -z "$want" ]; then ok "already: node, jq, gh"; return 0; fi
  if [ "$OS" != Darwin ]; then bad "missing:$want — $(pkg "$(echo $want | sed 's/node/nodejs/')")"; return 1; fi
  if ! has brew; then
    bad "missing:$want and no Homebrew — install Homebrew first (https://brew.sh), then re-run ./setup"; return 1
  fi
  if ask "Install with Homebrew:$want?"; then brew install $want && ok "installed:$want"; else bad "missing:$want — brew install$want"; return 1; fi
}

dirs() {
  step "config and data dirs"
  changed=""
  for d in "$HOME/.config/wt-memory" "$HOME/.config/wt-dashboard"; do [ -d "$d" ] || { mkdir -p "$d"; changed="$changed $d"; }; done
  env="$HOME/.config/wt-dashboard/env"
  [ -f "$env" ] || { : > "$env"; changed="$changed $env"; }
  chmod 600 "$env"
  if [ -z "$changed" ]; then ok "already: ~/.config/wt-memory, ~/.config/wt-dashboard/env"; else ok "created:$changed"; fi
  # The repo the dashboard reads worktrees and PRs from (UMKMALL_REPO is the legacy name).
  if grep -qs '^[[:space:]]*\(WT_DASHBOARD_REPO\|UMKMALL_REPO\)=' "$env"; then ok "already: dashboard repo set in $env"
  else
    r=$REPO
    if [ "$yes" -eq 0 ] && [ -t 0 ]; then printf '  Repo for dashboard worktrees and PRs [%s]: ' "$r"; read -r a; [ -n "$a" ] && r=$a; fi
    [ -z "$(tail -c1 "$env")" ] || echo >> "$env"
    printf 'WT_DASHBOARD_REPO=%s\n' "$r" >> "$env"; ok "WT_DASHBOARD_REPO=$r written to $env"
  fi
  # Before WP-82 the UMK Linear team was built in for an umkmall checkout; keep it for installs that use one.
  if ! grep -qs '^[[:space:]]*WT_LINEAR_TEAMS=' "$env" && grep -qs '^[[:space:]]*\(WT_DASHBOARD_REPO\|UMKMALL_REPO\)=.*/umkmall/*$' "$env"; then
    printf 'WT_LINEAR_TEAMS=UMK=umkmall\n' >> "$env"; ok "WT_LINEAR_TEAMS=UMK=umkmall written to $env (kept from the old built-in default)"
  fi
}

# WP-213: ONE wt-pack plugin. A full install loads this checkout as the plugin — CLAUDE_CODE_PLUGIN_DIRS in the `env`
# block of ~/.claude/settings.json, each entry loaded as `--plugin-dir`, so its skills, hooks, MCP and mods are one
# plugin and edits stay live — and the plugin-only install is wt-pack@wt-pack from the marketplace. Either way the
# four older plugins (wt-memory, wt-deliver-mod, wt-ask-mod, wt-mods) and the skill links in $SKILLS are gone.
SETTINGS="$HOME/.claude/settings.json"
PENV="$SK/wt-shared/scripts/plugin-env.mjs"
OLD_PLUGINS="wt-memory@wt-pack wt-deliver-mod@wt-pack wt-ask-mod@wt-pack"
plugin_dir() {
  step "plugin wt-pack (one plugin: this checkout)"
  if ! has claude; then bad "claude not on PATH — install Claude Code, then re-run"; return 1; fi
  # Another wt-pack checkout already owns the install (a plugin-dir entry, or the marketplace the plugin-only install
  # came from): keep it, add nothing and uninstall nothing — setup never repoints a live install from a worktree.
  other=""; have=0; mp=$(market_path)
  entries=$(node "$PENV" list "$SETTINGS" 2>/dev/null)
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    if [ "$d" = "$REPO" ]; then have=1; elif is_pack "$d"; then other=$d; fi
  done <<ENTRIES
$entries
ENTRIES
  [ -z "$other" ] && [ -n "$mp" ] && [ "$mp" != "$REPO" ] && is_pack "$mp" && other=$mp
  if [ -n "$other" ]; then opt "kept the wt-pack plugin install owned by $other (another wt-pack checkout): nothing added, nothing uninstalled"
  else
    if [ "$have" -eq 1 ]; then ok "already: $REPO in CLAUDE_CODE_PLUGIN_DIRS"
    elif node "$PENV" add "$SETTINGS" "$REPO"; then ok "added $REPO to CLAUDE_CODE_PLUGIN_DIRS in $SETTINGS (agents started before this need a respawn: plugin hooks load at session start)"
    else bad "could not edit $SETTINGS (is it valid JSON?)"; return 1; fi
    for id in $OLD_PLUGINS wt-pack@wt-pack; do
      plugin_listed "$id" || continue
      if claude plugin uninstall "$id" >/dev/null 2>&1; then ok "removed $id (the one wt-pack plugin replaces it)"; else bad "claude plugin uninstall $id failed"; fi
    done
  fi
  # The skill links are the old way in; the plugin carries every skill now. wt-dashboard stays linked: the desktop app
  # launches $SKILLS/wt-dashboard (WT_DASHBOARD_HOME overrides it).
  n=0; kept=""
  for l in "$SKILLS"/*; do
    [ -L "$l" ] || continue
    case "$(cd "$l" 2>/dev/null && pwd -P)|$(readlink "$l")" in
      "$REPO"/*|*"|$REPO"/*) [ "$(basename "$l")" = wt-dashboard ] || { rm "$l" && n=$((n + 1)); } ;;
      "$SKILLS"/*) ;;
      *"/skills/wt-"*|*"/wt-"*) t=$(cd "$l" 2>/dev/null && pwd -P); [ -n "$t" ] && is_pack "$(root_of "$t")" && kept=$(root_of "$t") ;;
    esac
  done
  [ "$n" -gt 0 ] && ok "removed $n skill link(s) into $REPO (their skills now come from the plugin)"
  [ -n "$kept" ] && opt "kept skill links into $kept (another wt-pack checkout)"
  return 0
}

# plugin_check: exactly one wt-pack plugin is loaded, none of the old four (WP-213).
plugin_check() {
  has claude || return 0
  ids=$(claude plugin list --json 2>/dev/null | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{for(const p of JSON.parse(s))if(p.enabled)console.log(p.id)}catch{process.exit(3)}})') \
    || { bad "could not read the plugin list (claude plugin list --json failed)"; return 0; }
  wp=$(printf '%s\n' "$ids" | grep -c '^wt-pack@')
  extras=""
  for id in $OLD_PLUGINS wt-mods@skills-dir wt-ask-mod@skills-dir; do printf '%s\n' "$ids" | grep -qx "$id" && extras="$extras $id"; done
  one=$(printf '%s\n' "$ids" | grep '^wt-pack@' | head -1)
  if [ "$wp" -eq 1 ] && [ -z "$extras" ]; then ok "one wt-pack plugin: $one"
  else
    [ "$wp" -eq 0 ] && bad "no wt-pack plugin loaded — ./setup install (then /reload-plugins, or respawn agents)"
    [ "$wp" -gt 1 ] && bad "$wp wt-pack plugins loaded ($(printf '%s' "$ids" | grep '^wt-pack@' | tr '\n' ' ')) — hooks and mods would run twice; keep one (./setup install uninstalls wt-pack@wt-pack)"
    [ -n "$extras" ] && bad "older plugins still loaded:$extras — ./setup install removes them (the one wt-pack plugin replaces them)"
  fi
  # Plugin-only install (wt-pack@wt-pack from the marketplace): its cache copy is stale once the checkout moves on.
  if printf '%s\n' "$ids" | grep -qx 'wt-pack@wt-pack'; then
    mp=$(market_path); riv=$(plugin_ver wt-pack@wt-pack); rsv=$(checkout_commit "${mp:-$REPO}")
    if [ -n "$rsv" ] && ! plugin_current "$riv" "${mp:-$REPO}" skills hooks .claude-plugin; then bad "plugin wt-pack@wt-pack $(printf '%.12s' "$riv") installed, checkout is at $(printf '%.12s' "$rsv") — claude plugin update wt-pack@wt-pack (then restart agents)"; fi
    [ -n "$mp" ] && { [ -d "$mp/.claude/worktrees" ] || [ -d "$mp/node_modules" ] || [ -d "$mp/skills/wt-dashboard/node_modules" ]; } \
      && opt "wt-pack@wt-pack was installed from the working checkout $mp — its worktrees and node_modules went into the plugin cache; install from GitHub (rephol/wt-pack) or a clean clone"
  fi
  # Leftover skill links (the old install): the plugin carries these skills now.
  stale=""
  for l in "$SKILLS"/wt-*; do [ -L "$l" ] && [ "$(basename "$l")" != wt-dashboard ] && stale="$stale $(basename "$l")"; done
  [ -n "$stale" ] && opt "old skill links still in $SKILLS:$stale — ./setup install removes those into this checkout"
  return 0
}

web() {
  step "dashboard (npm deps + web build)"
  w="$DASH/web"
  if [ -d "$w/node_modules" ] && [ "$w/node_modules/.package-lock.json" -nt "$w/package-lock.json" ] 2>/dev/null; then ok "already: web dependencies"
  else (cd "$w" && npm ci --no-audit --no-fund >/dev/null 2>&1) && ok "installed web dependencies (npm ci)" || { bad "npm ci in $w failed (run it there to see why)"; return 1; }; fi
  if built; then ok "already: web built"
  else (npm --prefix "$DASH" run build >/dev/null 2>&1) && ok "built web (skills/wt-dashboard/web/dist)" || { bad "npm --prefix $DASH run build failed"; return 1; }; fi
}

svc() {
  step "service (launchd)"
  if [ "$service" -eq 0 ]; then opt "skipped (--no-service)"; return 0; fi
  if [ "$OS" != Darwin ]; then opt "no launchd on $OS — run: npm --prefix $DASH start"; return 0; fi
  root=$(service_root)
  running=$(node "$DASH/scripts/service.mjs" status 2>/dev/null | grep -c ': running')
  if [ "$root" = "$DASH" ] && [ "$running" -eq 1 ]; then ok "already: running from $DASH"
    # WP-70: a service installed before the watchdog probe existed gets the probe here (install does both).
    # WP-218: a probe from before AbandonProcessGroup would kill the herdr server it starts; rewrite it.
    if ! grep -q AbandonProcessGroup "$HOME/Library/LaunchAgents/id.local.wtdashboard.watchdog.plist" 2>/dev/null; then node "$DASH/scripts/service.mjs" probe >/dev/null && ok "installed the watchdog probe" || bad "watchdog probe install failed — node $DASH/scripts/service.mjs probe"; fi
  # This checkout's pre-WP-69 path: service.mjs rewrites the plist from its own (new) location.
  elif [ "$root" = "$REPO/wt-dashboard" ]; then node "$DASH/scripts/service.mjs" install >/dev/null && ok "migrated service to $DASH" || bad "service migration failed — node $DASH/scripts/service.mjs install"
  elif [ -n "$root" ] && [ "$root" != "$DASH" ] && is_pack "$(root_of "$root")"; then opt "kept: the service runs $root (another wt-pack checkout)"
  else node "$DASH/scripts/service.mjs" install >/dev/null && ok "installed and started ($PLIST)" || bad "service install failed — node $DASH/scripts/service.mjs install"; fi
}

# WP-187: the wt-watch-prs background poller — optional (SKILL.md's §1 falls back to arming Monitors when it
# isn't running), installed the same way the dashboard's watchdog probe is: on by default, --no-service skips it.
wp_svc() {
  WH_PID="${WT_WATCH_PRS_HOME:-$HOME/.local/share/wt-watch-prs}/poller.pid"
  step "wt-watch-prs poller ($([ "$OS" = Darwin ] && echo launchd || { have_systemd_user && echo systemd || echo detached; }))"
  if [ "$service" -eq 0 ]; then opt "skipped (--no-service)"; return 0; fi
  wproot=$(wpservice_root)
  # WP-191: a service installed before the shim existed runs the script path directly — reinstall once to move it.
  if [ "$wproot" = "$WP" ] && [ -f "${WT_WATCH_PRS_HOME:-$HOME/.local/share/wt-watch-prs}/bin/watch-prs" ] && node "$WP/scripts/poller-service.mjs" status 2>/dev/null | grep -q running; then ok "already: running from $WP"
  elif [ -n "$wproot" ] && [ "$wproot" != "$WP" ] && is_pack "$(root_of "$wproot")"; then opt "kept: the poller runs $wproot (another wt-pack checkout)"
  else "$WP/scripts/watch-prs.sh" poller-install >/dev/null && ok "installed and started ($([ "$OS" = Darwin ] && echo "$WPPLIST" || { [ -f "$WPUNIT" ] && echo "$WPUNIT" || echo "detached, pid file $WH_PID"; }))" || bad "poller install failed — $WP/scripts/watch-prs.sh poller-install"; fi
  # A user unit stops at logout unless lingering is on; advise, never sudo.
  if [ "$OS" != Darwin ] && [ -f "$WPUNIT" ] && ! loginctl show-user "${USER:-$(id -un)}" -p Linger 2>/dev/null | grep -q 'Linger=yes'; then
    opt "the poller stops when you log out — keep it running: loginctl enable-linger ${USER:-$(id -un)}"
  fi
}

secrets_step() {
  step "optional keys"
  env="$HOME/.claude/.env"
  # WP-171: this used to check the env file only, so a machine with the key already in the Keychain (set via
  # the dashboard's own Settings, which prefers it) would prompt again here and write a SECOND copy into the
  # file — the two can then drift and one starts 401ing once it goes stale. Check both; write a new key to the
  # Keychain first (same medium the dashboard itself prefers), the file only when the Keychain isn't available.
  haskeychain=0
  if has security && security find-generic-password -s wt-dashboard -a TYPESAFE_API_KEY >/dev/null 2>&1; then haskeychain=1; fi
  if [ -n "${TYPESAFE_API_KEY:-}" ] || [ "$haskeychain" -eq 1 ] || grep -qs 'TYPESAFE_API_KEY=' "$env"; then ok "already: TypeSafe key"
  elif [ -t 0 ]; then
    printf '  TypeSafe API key (optional, Enter to skip): '; stty -echo 2>/dev/null; read -r k; stty echo 2>/dev/null; echo
    if [ -n "$k" ]; then
      if has security && printf 'add-generic-password -s wt-dashboard -a TYPESAFE_API_KEY -w "%s" -U\n' "$k" | security -i >/dev/null 2>&1; then
        ok "TypeSafe key saved to the Keychain"
      else
        mkdir -p "$HOME/.claude"; touch "$env"; chmod 600 "$env"; [ -z "$(tail -c1 "$env")" ] || echo >> "$env"; printf 'TYPESAFE_API_KEY=%s\n' "$k" >> "$env"; ok "TypeSafe key saved to $env"
      fi
    else opt "TypeSafe key skipped"; fi
  else opt "TypeSafe key: run ./setup secrets in a terminal"; fi
  opt "Linear key: dashboard Settings › Integrations (stored in the Keychain)"
}

install() {
  step "wt-pack install ($REPO)"
  deps; dirs; plugin_dir; web; svc; wp_svc
  if [ "$secrets" -eq 1 ] && [ -t 0 ]; then secrets_step; else step "optional keys"; opt "skipped (--no-secrets or not a terminal): ./setup secrets"; fi
  echo; doctor
}

# ---------------------------------------------------------------- uninstall
uninstall() {
  step "wt-pack uninstall ($REPO)"
  if [ "$OS" = Darwin ] && { [ "$(service_root)" = "$DASH" ] || [ "$(service_root)" = "$REPO/wt-dashboard" ]; }; then node "$DASH/scripts/service.mjs" uninstall >/dev/null && ok "service removed"
  else opt "service: not installed from this checkout, left alone"; fi
  if [ "$(wpservice_root)" = "$WP" ]; then "$WP/scripts/watch-prs.sh" poller-uninstall >/dev/null && ok "watchprs poller removed"
  else opt "watchprs poller: not installed from this checkout, left alone"; fi
  if has claude; then
    mine=0; node "$PENV" list "$SETTINGS" 2>/dev/null | grep -qxF "$REPO" && mine=1
    [ "$(market_path)" = "$REPO" ] && mine=1
    if [ "$mine" -eq 1 ]; then
      for id in $OLD_PLUGINS wt-pack@wt-pack; do plugin_listed "$id" && claude plugin uninstall "$id" >/dev/null 2>&1 && ok "uninstalled $id"; done
      [ "$(market_path)" = "$REPO" ] && claude plugin marketplace remove wt-pack >/dev/null 2>&1 && ok "marketplace wt-pack removed"
      if node "$PENV" remove "$SETTINGS" "$REPO"; then ok "plugin dir $REPO removed from $SETTINGS (if it was there)"; else bad "could not edit $SETTINGS (is it valid JSON?)"; fi
    else opt "plugin: not installed from this checkout, left alone"; fi
  else opt "claude not on PATH: plugin left alone"; fi
  n=0
  for l in "$SKILLS"/*; do
    [ -L "$l" ] || continue
    # readlink too: a pre-WP-69 link into this checkout dangles, so cd fails on it.
    case "$(cd "$l" 2>/dev/null && pwd -P)|$(readlink "$l")" in "$REPO"/*|*"|$REPO"/*) rm "$l" && n=$((n + 1)) ;; esac
  done
  ok "removed $n skill link(s) pointing into $REPO"
  keep="$HOME/.local/share/wt-dashboard $HOME/.config/wt-dashboard $HOME/.config/wt-memory $HOME/Library/Logs/wt-dashboard"
  if [ "$purge" -eq 1 ] && ask "Delete $HOME/.local/share/wt-dashboard and $HOME/.config/wt-dashboard?"; then
    rm -rf "$HOME/.local/share/wt-dashboard" "$HOME/.config/wt-dashboard" && ok "purged dashboard data and config"
  else opt "kept (delete by hand, or --purge): $keep; Keychain service wt-dashboard; ~/.claude/.env"; fi
}

case "$cmd" in
  doctor) doctor ;;
  install) install ;;
  secrets) secrets_step ;;
  plugin) plugin_dir ;;
  plugin-check) fails=0; plugin_check ;;
  uninstall) uninstall ;;
esac
