#!/bin/sh
# wt-pack setup: one command from a fresh clone to a working pack.
#
#   ./setup [install] [--yes] [--no-secrets] [--no-service]   # idempotent; ends with doctor
#   ./setup doctor [--no-service]                             # one line per need; exit 1 if a required one fails
#   ./setup secrets                                           # optional keys (TypeSafe; Linear via the dashboard)
#   ./setup uninstall [--purge] [--yes]                       # links, plugin, service; keeps data unless --purge
#
# Never installs without asking: missing Homebrew packages are listed and installed after one y/N (--yes skips
# it); a missing Homebrew or herdr is a printed hint, never a piped installer. Anything that already points at
# ANOTHER wt-pack checkout (a skill link, the plugin marketplace, the launchd service) is reported and kept, so
# running this from a worktree never repoints the live install. macOS-first; Linux gaps are printed by doctor.
set -u

REPO=$(cd "$(dirname "$0")" && pwd -P)
SKILLS="$HOME/.claude/skills"
SK="$REPO/skills"
DASH="$SK/wt-dashboard"
PLIST="$HOME/Library/LaunchAgents/id.local.wtdashboard.server.plist"
PORT=${PORT:-7777}
OS=$(uname -s)

cmd=install; yes=0; secrets=1; service=1; purge=0
for a in "$@"; do
  case "$a" in
    install|doctor|uninstall|secrets) cmd=$a ;;
    --yes|-y) yes=1 ;;
    --no-secrets) secrets=0 ;;
    --no-service) service=0 ;;
    --purge) purge=1 ;;
    -h|--help) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "setup: unknown argument: $a (see ./setup --help)" >&2; exit 2 ;;
  esac
done

ok()   { printf '  \342\234\223 %s\n' "$*"; }          # ✓
bad()  { printf '  \342\234\227 %s\n' "$*"; fails=$((fails + 1)); }  # ✗ (required)
opt()  { printf '  \342\200\223 %s\n' "$*"; }          # – (optional / note)
step() { printf '%s\n' "$*"; }
has()  { command -v "$1" >/dev/null 2>&1; }
ask()  { [ "$yes" -eq 1 ] && return 0; [ -t 0 ] || return 1; printf '%s [y/N] ' "$1"; read -r r; [ "$r" = y ] || [ "$r" = Y ]; }
fails=0

# A wt-pack checkout: a directory with the pack's marketplace manifest.
is_pack() { [ -f "$1/.claude-plugin/marketplace.json" ] && grep -q '"name": *"wt-pack"' "$1/.claude-plugin/marketplace.json"; }
# The checkout a skill dir belongs to: <co>/skills/<s> (this layout) or <co>/<s> (before WP-69).
root_of() { d=$(dirname "$1"); if [ "$(basename "$d")" = skills ]; then dirname "$d"; else echo "$d"; fi; }
# A checkout's dir for skill $2, in whichever layout it has.
skill_dir() { if [ -d "$1/skills/$2" ]; then echo "$1/skills/$2"; else echo "$1/$2"; fi; }
skills() { for d in "$SK"/wt-*/; do [ -f "$d/SKILL.md" ] || [ "$(basename "$d")" = wt-shared ] && basename "$d"; done; }
node_ok() { has node && node -e 'const [a,b]=process.versions.node.split(".").map(Number);process.exit(a>22||(a===22&&b>=13)?0:1)'; }
service_root() { [ -f "$PLIST" ] && plutil -extract ProgramArguments.1 raw "$PLIST" 2>/dev/null | sed 's#/server.mjs$##'; }
# JSON via node (required anyway), not jq: a missing jq must not read as a missing plugin.
market_path() { claude plugin marketplace list --json 2>/dev/null | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{const m=JSON.parse(s).find(x=>x.name==="wt-pack");if(m)console.log(m.path||m.installLocation||"")}catch{}})'; }
# plugin_ok [enabled]: wt-memory@wt-pack is installed (and enabled).
plugin_ok() { claude plugin list --json 2>/dev/null | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{process.exit(JSON.parse(s).some(p=>p.id==="wt-memory@wt-pack"&&(!process.argv[1]||p.enabled))?0:1)}catch{process.exit(1)}})' "${1:-}"; }
# Install hint for a missing package, for this OS.
# sudo only when needed: root (a container) often has no sudo at all.
SUDO=$([ "$(id -u)" -eq 0 ] && echo "" || echo "sudo ")
pkg() { if [ "$OS" = Darwin ]; then echo "brew install $1"; elif has apt-get; then echo "${SUDO}apt-get install -y $1"; elif has dnf; then echo "${SUDO}dnf install -y $1"; else echo "install $1 with your package manager"; fi; }
# The OTHER wt-pack checkout the existing skill links point into ("" when none, or when it is this one).
link_home() { for l in "$SKILLS"/wt-*; do t=$([ -L "$l" ] && cd "$l" 2>/dev/null && pwd -P) || continue; h=$(root_of "$t"); [ "$h" != "$REPO" ] && is_pack "$h" && { echo "$h"; return; }; done; }
# herdr: report, never install. $1 = bad|opt (how a missing herdr counts); $2 = 1 also runs `herdr config check`.
herdr_check() {
  if ! has herdr; then
    $1 "herdr — needed for agents, handoffs and rooms; run: $(if has brew; then echo 'brew install herdr'; else echo 'curl -fsSL https://herdr.dev/install.sh | sh'; fi)"; return
  fi
  how="direct install, update: herdr update"; has brew && brew list herdr >/dev/null 2>&1 && how="Homebrew, update: brew upgrade herdr"
  ok "$(herdr --version 2>/dev/null | head -1) ($how)"
  case "$(herdr integration status 2>/dev/null | grep '^claude:')" in
    "claude: current"*) ok "herdr claude integration" ;;
    *) opt "herdr claude integration missing or outdated (agent state) — run: herdr integration install claude" ;;
  esac
  [ "${2:-0}" = 1 ] || return 0
  if herdr config check >/dev/null 2>&1; then ok "herdr config"; else opt "herdr config check reports problems — run: herdr config check"; fi
  # The dashboard reads agents from the herdr server; without one its Overview cannot load.
  if herdr status server 2>/dev/null | grep -q '^status: running'; then ok "herdr server running"; else opt "herdr server not running — start it with: herdr (the dashboard needs it for agents)"; fi
}
built() { [ -f "$DASH/web/dist/index.html" ] && [ -z "$(find "$DASH/web/src" "$DASH/web/index.html" "$DASH/web/package.json" -newer "$DASH/web/dist/index.html" 2>/dev/null | head -1)" ]; }

# ---------------------------------------------------------------- doctor
doctor() {
  fails=0
  step "wt-pack doctor ($REPO)"
  if node_ok; then ok "node $(node -v)"; else bad "node >= 22.13 (have: $(node -v 2>/dev/null || echo none)) — $(pkg node)"; fi
  if has node && node -e "process.getBuiltinModule('node:sqlite')" >/dev/null 2>&1; then ok "node:sqlite"; else bad "node:sqlite unavailable — node >= 22.13"; fi
  for c in git curl; do if has $c; then ok "$c"; elif [ "$OS" = Darwin ]; then bad "$c — xcode-select --install"; else bad "$c — $(pkg $c)"; fi; done
  if has jq; then ok "jq"; else bad "jq — $(pkg jq)"; fi
  if ! has gh; then bad "gh — $(pkg gh)"
  elif gh auth status >/dev/null 2>&1; then ok "gh (authenticated)"
  else bad "gh not logged in — run: gh auth login"; fi
  herdr_check bad 1
  if has claude; then ok "claude"; else bad "claude (Claude Code) not on PATH"; fi

  n=0; miss=""; other=""; home=$(link_home); later=""
  for s in $(skills); do
    l="$SKILLS/$s"
    t=$([ -L "$l" ] && cd "$l" 2>/dev/null && pwd -P)
    if [ "$t" = "$SK/$s" ]; then n=$((n + 1))
    elif [ -n "$t" ] && [ "$(basename "$t")" = "$s" ] && is_pack "$(root_of "$t")"; then n=$((n + 1)); other=$(root_of "$t")
    elif [ -z "$t" ] && [ -n "$home" ] && [ ! -d "$(skill_dir "$home" "$s")" ]; then later="$later $s"
    else miss="$miss $s"; fi
  done
  [ -n "$later" ] && opt "not linked yet:$later (new here; $home has none yet — run ./setup there after merging)"
  if [ -z "$miss" ]; then ok "skills linked in $SKILLS ($n)${other:+ — from $other}"; else bad "skills not linked:$miss — ./setup install"; fi

  grep -qs "$REPO/wt-shared/hooks/" "$HOME/.claude/settings.json" \
    && opt "~/.claude/settings.json runs a hook from $REPO/wt-shared/hooks (pre-WP-69 path) — change it to ~/.claude/skills/wt-shared/hooks/"

  mp=$(market_path)
  if plugin_ok enabled; then
    ok "plugin wt-memory@wt-pack${mp:+ (marketplace $mp)}"
  else bad "plugin wt-memory@wt-pack not installed — ./setup install"; fi

  if [ -f "$DASH/web/dist/index.html" ]; then
    if built; then ok "dashboard web built"; else opt "dashboard web built, but older than web/src — npm --prefix skills/wt-dashboard run build"; fi
  else bad "dashboard web not built — ./setup install"; fi

  if [ "$service" -eq 0 ]; then opt "service not checked (--no-service)"
  elif [ "$OS" = Darwin ]; then
    root=$(service_root)
    if [ -z "$root" ]; then bad "launchd service not installed — ./setup install"
    else
      st=$(node "$DASH/scripts/service.mjs" status 2>/dev/null | head -1)
      case "$st" in
        *": running"*) ok "service ${st%%,*}${root:+ — runs $root}" ;;
        *) bad "service: ${st:-unknown} — node $DASH/scripts/service.mjs install" ;;
      esac
    fi
  else
    opt "no launchd on $OS: run the dashboard with  npm --prefix $DASH start  (a systemd user unit is not provided)"
  fi
  code=$(curl -s -o /dev/null -m 3 -w '%{http_code}' "http://127.0.0.1:$PORT/" 2>/dev/null)
  case "$code" in 2*|3*|401|403) ok "dashboard answers on http://127.0.0.1:$PORT ($code)" ;;
    *) if [ "$OS" = Darwin ]; then bad "dashboard not answering on 127.0.0.1:$PORT (http ${code:-none})"; else opt "dashboard not running on 127.0.0.1:$PORT"; fi ;; esac
  # WP-80: the bind address (this shell, or the systemd unit from docs/vm.md). Loopback is the only safe default.
  unit="$HOME/.config/systemd/user/wt-dashboard.service"
  bind=${WT_DASHBOARD_HOST:-$( [ -f "$unit" ] && sed -n 's/^Environment=WT_DASHBOARD_HOST=//p' "$unit" | head -1 )}
  case "${bind:-127.0.0.1}" in
    127.0.0.1|::1|localhost) ok "dashboard binds loopback (${bind:-127.0.0.1}); reach it remotely with Tailscale or ssh -L, see docs/vm.md" ;;
    *) opt "dashboard bind WT_DASHBOARD_HOST=$bind is not loopback — the server refuses it without WT_ALLOW_REMOTE=1; prefer Tailscale or ssh -L (docs/vm.md)" ;;
  esac

  [ -f "$HOME/.config/wt-dashboard/env" ] && ok "config ~/.config/wt-dashboard/env" || opt "no ~/.config/wt-dashboard/env yet (./setup install creates it)"
  [ -d "$HOME/.config/wt-memory" ] && ok "memory store ~/.config/wt-memory" || opt "no ~/.config/wt-memory yet (./setup install creates it)"

  # optional
  if [ -n "${TYPESAFE_API_KEY:-}" ] || grep -qs '^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}TYPESAFE_API_KEY=' "$HOME/.claude/.env" \
     || { has security && security find-generic-password -s wt-dashboard -a TYPESAFE_API_KEY >/dev/null 2>&1; }; then ok "TypeSafe key (optional)"
  else opt "TypeSafe key not set (optional: ./setup secrets)"; fi
  if has security && security find-generic-password -s wt-dashboard -a LINEAR_API_KEY >/dev/null 2>&1; then ok "Linear key (optional)"
  else opt "Linear key not set (optional: dashboard Settings › Integrations)"; fi
  has tailscale && ok "tailscale (optional, remote access)" || opt "tailscale not installed (optional, remote access)"
  has agent-browser && ok "agent-browser (optional, preferred for browser checks)" || opt "agent-browser not installed (optional, preferred for browser checks): npm i -g agent-browser && agent-browser install"
  has cargo && ok "cargo (optional, Tauri app)" || opt "cargo not installed (optional, only for the Tauri app)"
  for c in codex gemini; do has $c && opt "$c found: wt-memory hookup is manual, see skills/wt-memory/SKILL.md"; done
  [ "$OS" = Darwin ] || opt "Linux: no launchd, no Keychain (keys go in ~/.config/wt-dashboard/env), no brew prompt (apt: nodejs jq gh git curl), no Tauri app"

  if [ "$fails" -eq 0 ]; then step "doctor: all required checks pass"; return 0; fi
  step "doctor: $fails required check(s) failing"; return 1
}

# ---------------------------------------------------------------- install
deps() {
  step "dependencies"
  want=""
  node_ok || want="$want node"
  has jq || want="$want jq"
  has gh || want="$want gh"
  has git || want="$want git"
  has curl || want="$want curl"
  herdr_check opt
  if [ -z "$want" ]; then ok "already: node, jq, gh"; return 0; fi
  if [ "$OS" != Darwin ]; then bad "missing:$want — $(pkg "$(echo $want | sed 's/node/nodejs/')")"; return 1; fi
  if ! has brew; then
    bad "missing:$want and no Homebrew — install Homebrew first (https://brew.sh), then re-run ./setup"; return 1
  fi
  if ask "Install with Homebrew:$want?"; then brew install $want && ok "installed:$want"; else bad "missing:$want — brew install$want"; return 1; fi
}

link_skills() {
  step "skills → $SKILLS"
  mkdir -p "$SKILLS"
  made=0; kept=0; moved=0; elsewhere=""; home=$(link_home)
  for s in $(skills); do
    l="$SKILLS/$s"; want="$SK/$s"
    if [ -L "$l" ]; then
      t=$(cd "$l" 2>/dev/null && pwd -P)
      if [ "$t" = "$want" ]; then kept=$((kept + 1))
      # This checkout's pre-WP-69 path (<repo>/<s>, now dangling): re-point it.
      elif [ "$(readlink "$l")" = "$REPO/$s" ]; then ln -sfn "$want" "$l" && moved=$((moved + 1))
      elif [ -n "$t" ] && is_pack "$(root_of "$t")"; then elsewhere=$(root_of "$t"); kept=$((kept + 1))
      else bad "not touching $l: it links to ${t:-a missing path}, not a wt-pack checkout"; fi
    elif [ -e "$l" ]; then bad "not touching $l: it is a real file/directory, not a link"
    elif [ -n "$home" ]; then opt "not linking $s: the other skills come from $home, which has no $s yet — re-run ./setup there after merging"
    else ln -s "$want" "$l" && made=$((made + 1)); fi
  done
  [ -n "$elsewhere" ] && opt "kept links into $elsewhere (another wt-pack checkout)"
  [ "$moved" -gt 0 ] && ok "migrated $moved link(s) to $SK"
  if [ "$made" -eq 0 ] && [ "$moved" -eq 0 ]; then ok "already: $kept linked"; elif [ "$made" -gt 0 ]; then ok "linked $made new (${kept} already)"; fi
}

dirs() {
  step "config and data dirs"
  changed=""
  for d in "$HOME/.config/wt-memory" "$HOME/.config/wt-dashboard"; do [ -d "$d" ] || { mkdir -p "$d"; changed="$changed $d"; }; done
  env="$HOME/.config/wt-dashboard/env"
  [ -f "$env" ] || { : > "$env"; changed="$changed $env"; }
  chmod 600 "$env"
  if [ -z "$changed" ]; then ok "already: ~/.config/wt-memory, ~/.config/wt-dashboard/env"; else ok "created:$changed"; fi
  # The repo the dashboard reads worktrees and PRs from (UMKMALL_REPO is the legacy name).
  if grep -qs '^[[:space:]]*\(WT_DASHBOARD_REPO\|UMKMALL_REPO\)=' "$env"; then ok "already: dashboard repo set in $env"
  else
    r=$REPO
    if [ "$yes" -eq 0 ] && [ -t 0 ]; then printf '  Repo for dashboard worktrees and PRs [%s]: ' "$r"; read -r a; [ -n "$a" ] && r=$a; fi
    [ -z "$(tail -c1 "$env")" ] || echo >> "$env"
    printf 'WT_DASHBOARD_REPO=%s\n' "$r" >> "$env"; ok "WT_DASHBOARD_REPO=$r written to $env"
  fi
  # Before WP-82 the UMK Linear team was built in for an umkmall checkout; keep it for installs that use one.
  if ! grep -qs '^[[:space:]]*WT_LINEAR_TEAMS=' "$env" && grep -qs '^[[:space:]]*\(WT_DASHBOARD_REPO\|UMKMALL_REPO\)=.*/umkmall/*$' "$env"; then
    printf 'WT_LINEAR_TEAMS=UMK=umkmall\n' >> "$env"; ok "WT_LINEAR_TEAMS=UMK=umkmall written to $env (kept from the old built-in default)"
  fi
}

plugin() {
  step "plugin wt-memory"
  if ! has claude; then bad "claude not on PATH — install Claude Code, then re-run"; return 1; fi
  mp=$(market_path)
  if [ -z "$mp" ]; then claude plugin marketplace add "$REPO" >/dev/null 2>&1 && ok "marketplace wt-pack added ($REPO)" || { bad "claude plugin marketplace add $REPO failed"; return 1; }
  elif [ "$mp" != "$REPO" ] && is_pack "$mp"; then opt "kept marketplace wt-pack → $mp (another wt-pack checkout)"
  elif [ "$mp" != "$REPO" ]; then bad "a marketplace named wt-pack points at $mp, which is not a wt-pack checkout"; return 1
  fi
  if plugin_ok; then
    ok "already: wt-memory@wt-pack installed"
  else claude plugin install wt-memory@wt-pack >/dev/null 2>&1 && ok "installed wt-memory@wt-pack" || bad "claude plugin install wt-memory@wt-pack failed"; fi
}

web() {
  step "dashboard (npm deps + web build)"
  w="$DASH/web"
  if [ -d "$w/node_modules" ] && [ "$w/node_modules/.package-lock.json" -nt "$w/package-lock.json" ] 2>/dev/null; then ok "already: web dependencies"
  else (cd "$w" && npm ci --no-audit --no-fund >/dev/null 2>&1) && ok "installed web dependencies (npm ci)" || { bad "npm ci in $w failed (run it there to see why)"; return 1; }; fi
  if built; then ok "already: web built"
  else (npm --prefix "$DASH" run build >/dev/null 2>&1) && ok "built web (skills/wt-dashboard/web/dist)" || { bad "npm --prefix $DASH run build failed"; return 1; }; fi
}

svc() {
  step "service (launchd)"
  if [ "$service" -eq 0 ]; then opt "skipped (--no-service)"; return 0; fi
  if [ "$OS" != Darwin ]; then opt "no launchd on $OS — run: npm --prefix $DASH start"; return 0; fi
  root=$(service_root)
  running=$(node "$DASH/scripts/service.mjs" status 2>/dev/null | grep -c ': running')
  if [ "$root" = "$DASH" ] && [ "$running" -eq 1 ]; then ok "already: running from $DASH"
    # WP-70: a service installed before the watchdog probe existed gets the probe here (install does both).
    if [ ! -f "$HOME/Library/LaunchAgents/id.local.wtdashboard.watchdog.plist" ]; then node "$DASH/scripts/service.mjs" probe >/dev/null && ok "installed the watchdog probe" || bad "watchdog probe install failed — node $DASH/scripts/service.mjs probe"; fi
  # This checkout's pre-WP-69 path: service.mjs rewrites the plist from its own (new) location.
  elif [ "$root" = "$REPO/wt-dashboard" ]; then node "$DASH/scripts/service.mjs" install >/dev/null && ok "migrated service to $DASH" || bad "service migration failed — node $DASH/scripts/service.mjs install"
  elif [ -n "$root" ] && [ "$root" != "$DASH" ] && is_pack "$(root_of "$root")"; then opt "kept: the service runs $root (another wt-pack checkout)"
  else node "$DASH/scripts/service.mjs" install >/dev/null && ok "installed and started ($PLIST)" || bad "service install failed — node $DASH/scripts/service.mjs install"; fi
}

secrets_step() {
  step "optional keys"
  env="$HOME/.claude/.env"
  if [ -n "${TYPESAFE_API_KEY:-}" ] || grep -qs 'TYPESAFE_API_KEY=' "$env"; then ok "already: TypeSafe key"
  elif [ -t 0 ]; then
    printf '  TypeSafe API key (optional, Enter to skip): '; stty -echo 2>/dev/null; read -r k; stty echo 2>/dev/null; echo
    if [ -n "$k" ]; then mkdir -p "$HOME/.claude"; touch "$env"; chmod 600 "$env"; [ -z "$(tail -c1 "$env")" ] || echo >> "$env"; printf 'TYPESAFE_API_KEY=%s\n' "$k" >> "$env"; ok "TypeSafe key saved to $env"; else opt "TypeSafe key skipped"; fi
  else opt "TypeSafe key: run ./setup secrets in a terminal"; fi
  opt "Linear key: dashboard Settings › Integrations (stored in the Keychain)"
}

install() {
  step "wt-pack install ($REPO)"
  deps; link_skills; dirs; plugin; web; svc
  if [ "$secrets" -eq 1 ] && [ -t 0 ]; then secrets_step; else step "optional keys"; opt "skipped (--no-secrets or not a terminal): ./setup secrets"; fi
  echo; doctor
}

# ---------------------------------------------------------------- uninstall
uninstall() {
  step "wt-pack uninstall ($REPO)"
  if [ "$OS" = Darwin ] && { [ "$(service_root)" = "$DASH" ] || [ "$(service_root)" = "$REPO/wt-dashboard" ]; }; then node "$DASH/scripts/service.mjs" uninstall >/dev/null && ok "service removed"
  else opt "service: not installed from this checkout, left alone"; fi
  if has claude && [ "$(market_path)" = "$REPO" ]; then
    claude plugin uninstall wt-memory@wt-pack >/dev/null 2>&1; claude plugin marketplace remove wt-pack >/dev/null 2>&1
    ok "plugin wt-memory@wt-pack and marketplace wt-pack removed"
  else opt "plugin: not installed from this checkout, left alone"; fi
  n=0
  for l in "$SKILLS"/*; do
    [ -L "$l" ] || continue
    # readlink too: a pre-WP-69 link into this checkout dangles, so cd fails on it.
    case "$(cd "$l" 2>/dev/null && pwd -P)|$(readlink "$l")" in "$REPO"/*|*"|$REPO"/*) rm "$l" && n=$((n + 1)) ;; esac
  done
  ok "removed $n skill link(s) pointing into $REPO"
  keep="$HOME/.local/share/wt-dashboard $HOME/.config/wt-dashboard $HOME/.config/wt-memory $HOME/Library/Logs/wt-dashboard"
  if [ "$purge" -eq 1 ] && ask "Delete $HOME/.local/share/wt-dashboard and $HOME/.config/wt-dashboard?"; then
    rm -rf "$HOME/.local/share/wt-dashboard" "$HOME/.config/wt-dashboard" && ok "purged dashboard data and config"
  else opt "kept (delete by hand, or --purge): $keep; Keychain service wt-dashboard; ~/.claude/.env"; fi
}

case "$cmd" in
  doctor) doctor ;;
  install) install ;;
  secrets) secrets_step ;;
  uninstall) uninstall ;;
esac
