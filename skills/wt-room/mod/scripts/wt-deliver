#!/usr/bin/env bash
# wt-deliver — the wt-deliver-mod's calls to wt-dashboard's delivery queue (WP-210). Identity: $HC_TERMINAL_ID.
#   wt-deliver hello           liveness: the dashboard queues for this pane while hellos are fresh
#   wt-deliver next            print the oldest queued delivery as JSON ({} when none)
#   wt-deliver ack <id> [delivered|failed]
#   wt-deliver check-finish    end of a turn: the dashboard queues ONE reminder if a handed-off card is still open (WP-272)
# Exit 0 ok, 1 unreachable or API error.
set -u
API=${HERDR_DASH_URL:-http://127.0.0.1:7777}
[ -n "${HC_TERMINAL_ID:-}" ] || exit 1
# WP-320: a claude started from inside a terminal inherits HC_TERMINAL_ID; only the terminal's own (outermost) claude
# may take its deliveries. Another `claude` between this one and the hc holder in the process tree means we are nested: stand down.
# WP-378 (S3): the holder is `<dir>/hc hold --socket …` (the default core shows `herdr-core hold …`); the core and whatever started it sit
# above and do not count (a core started from an agent's shell has that claude above it).
# D7: the holder is argv[0] hc|herdr-core with argv[1] `hold` (a script holder shows as `<interpreter> <dir>/hc hold`); a process whose args merely
# MENTION `hc hold` (a claude, a grep) is not one.
is_holder() {
  local -a W; read -ra W <<< "$1"
  local b0=${W[0]-} b1=${W[1]-}; b0=${b0##*/}; b1=${b1##*/} # unset elements: set -u aborts on bash 4.4+/5
  case "$b0" in
    hc|herdr-core) [ "${W[1]-}" = hold ] ;;
    sh|bash|zsh|dash|node|env) case "$b1" in hc|herdr-core) [ "${W[2]-}" = hold ] ;; *) return 1 ;; esac ;;
    *) return 1 ;;
  esac
}
p=$$; seen=0
while [ "${p:-0}" -gt 1 ]; do
  pp=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ') || break
  c=$(ps -o comm= -p "$p" 2>/dev/null); a=$(ps -o args= -p "$p" 2>/dev/null)
  is_holder "$a" && break
  case "${c##*/}" in claude) seen=$((seen + 1)) ;; esac
  p=${pp:-0}
done
[ "$seen" -le 1 ] || exit 1
call() {
  local out code
  out=$(curl -sS --max-time 4 -w '\n%{http_code}' -X "$1" -H "x-herdr-pane: $HC_TERMINAL_ID" ${WT_PANE_KEY:+-H "x-wt-pane-key: $WT_PANE_KEY"} -H 'content-type: application/json' ${3:+--data "$3"} "$API$2" 2>/dev/null) || exit 1
  code=${out##*$'\n'}; out=${out%$'\n'*}
  [ "$code" -lt 400 ] || exit 1
  printf '%s\n' "$out"
}
case "${1:-}" in
  hello) call POST /api/deliveries/hello '{}' >/dev/null ;;
  next) call GET /api/deliveries/next ;;
  ack) [ -n "${2:-}" ] || exit 2; call POST "/api/deliveries/$2/ack" "{\"status\":\"${3:-delivered}\"}" >/dev/null ;;
  check-finish) call GET /api/messages/check-finish >/dev/null ;;
  *) echo "usage: wt-deliver hello|next|ack <id> [status]|check-finish" >&2; exit 2 ;;
esac
