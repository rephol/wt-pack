#!/usr/bin/env node
// Tool-agnostic agent preferences: plain markdown files any agent runtime can be fed.
//
//   wt-memory context [--role R] [--project P] [--cwd D] [--strict-pane]   # --strict-pane: herdr pane lookup failed → print nothing, exit 75 (WP-369)
//   (a store line may start with [role: a, b] / [project: p] tags: only matching agents get it, WP-369)
//   # merged markdown: global → role → project → project-role files (.wt-pack/roles/, WP-204)
//   wt-memory hash    [same flags]                         # short content hash of that output
//   wt-memory path    [global | role R | project P]        # the store dir, or one file's path
//   wt-memory remember "<note>" [--scope role|project|global] [--role R] [--project P] [--strict]
//   wt-memory recall "<prompt>" --session S [--limit 5]  # WP-235: ≤5 agent-kept memories of this scope sharing keywords with the prompt, not yet shown this session
//   wt-memory forget <id> · accept <id> · reject <id> · list [--scope S] [--json]
//
// Store: $WT_MEMORY_HOME or ~/.config/wt-memory → global.md, roles/<role-id>.md, projects/<repo>.md.
// Without flags the scope is inferred: $HERDR_PANE_ID → `herdr pane get` → tokens role/project and the pane's
// cwd; project falls back to the git repo of the cwd (a worktree resolves to its MAIN repo, as the dashboard does).
// Runs inside agent hooks, so `context`/`hash` never fail loudly: any error → exit 0 and empty output.
import { readFileSync, writeFileSync, appendFileSync, renameSync, mkdirSync, readdirSync, unlinkSync } from 'node:fs'
import { execFileSync } from 'node:child_process'
import { createHash, randomBytes } from 'node:crypto'
import { join, basename, dirname } from 'node:path'
import { homedir } from 'node:os'

const HOME = process.env.WT_MEMORY_HOME || join(homedir(), '.config', 'wt-memory')
const NAME = /^[A-Za-z0-9][\w.-]{0,99}$/ // role ids and repo basenames; no slashes, no leading dot
const file = (kind, name) => {
  if (kind === 'global') return join(HOME, 'global.md')
  if (!NAME.test(name ?? '')) throw new Error(`bad ${kind} name: ${name}`)
  return join(HOME, kind === 'role' ? 'roles' : 'projects', `${name}.md`)
}
const read = (f) => { try { return readFileSync(f, 'utf8').trim() } catch { return '' } }
// Injected text never carries HTML comments: not the template's, not agent-entry trailers.
const body = (s) => s.replace(/ *<!--[\s\S]*?-->/g, '').replace(/\n{3,}/g, '\n\n').trim()
// Agent-written entries are one bullet line each, with a trailer the injected text never shows.
const TRAILER = / *<!-- wtm:([^>]*?) *-->/
const strip = (s) => s.replace(/ *<!-- wtm:[^>]*?-->/g, '')

// WP-369 line tags: after an optional bullet, groups `[role: a, b]` / `[project: p]` (values match NAME). Anything else in
// brackets is ordinary text (fail open). tagsOf is the one parser: merge, entries and recall all use it.
const TAG = /\[(role|project):([^\]\n]*)\]\s*/y
function tagsOf(line) {
  const pre = line.match(/^\s*(?:[-*]\s+)?/)[0]
  const tags = {}
  let i = pre.length
  for (;;) {
    TAG.lastIndex = i
    const m = TAG.exec(line)
    if (!m) break
    const vals = m[2].split(',').map((v) => v.trim())
    if (!vals.length || !vals.every((v) => NAME.test(v))) return { tags: {}, text: line, pre }
    tags[m[1]] = [...new Set([...(tags[m[1]] ?? []), ...vals])]
    i = TAG.lastIndex
  }
  return i === pre.length ? { tags: {}, text: line, pre } : { tags, text: line.slice(i), pre }
}
const tagStr = (t = {}) => ['role', 'project'].filter((k) => t[k]?.length).map((k) => `[${k}: ${t[k].join(', ')}]`).join(' ')
const sameTags = (a = {}, b = {}) => tagStr(a) === tagStr(b)
// OR within a kind, AND across kinds; a role tag matches the role or the persona. Unknown role/project → no match.
const tagsMatch = (t, { role, persona, project }) =>
  (!t.role || [role, persona].some((x) => x && t.role.includes(x))) && (!t.project || (project && t.project.includes(project)))
// Drops lines (and their indented continuations) addressed to someone else; strips the tags from the rest.
function applyTags(text, ctx) {
  let changed = false, skipping = false
  const out = []
  for (const l of text.split('\n')) {
    if (skipping && /^\s+\S/.test(l)) { changed = true; continue }
    skipping = false
    const { tags, text: rest, pre } = tagsOf(l)
    if (!tagStr(tags)) { out.push(l); continue }
    changed = true
    if (tagsMatch(tags, ctx)) out.push(pre + rest); else skipping = true
  }
  return changed ? out.join('\n').replace(/\n{3,}/g, '\n\n').trim() : text
}

async function merge({ role, project, persona, cwd }) {
  const ctx = { role, persona, project }
  const parts = [['Global preferences', applyTags(body((read(file('global')))), ctx)]]
  if (role && NAME.test(role)) parts.push([`Role preferences (${role})`, applyTags(body((read(file('role', role)))), ctx)])
  if (project && NAME.test(project)) parts.push([`Project preferences (${project})`, applyTags(body((read(file('project', project)))), ctx)])
  // WP-204: project-role files from the repo's main checkout. Dynamic import: only `context` needs wt-shared.
  if (role || persona) {
    try {
      const r = await import('../../wt-shared/scripts/roles.mjs')
      const co = r.mainCheckout(cwd || process.cwd())
      parts.push(...r.sections(co, role, persona).map(([h, t]) => [h, body(t)]))
      if (co) parts.push(['Project roles', r.untrustedNotice(co)]) // WP-334: repo role files not trusted → one line, base roles apply
      // WP-289: an orchestrator picks personas, so tell it where they live (user level is easy to miss)
      if (co && role === 'orchestrator') parts.push(['Personas', `Project personas are role files; \`wt-roles list\` shows them. ${r.rootsLine(co)}`])
    } catch {}
  }
  return parts.filter(([, t]) => t).map(([h, t]) => `## ${h}\n\n${t}`).join('\n\n')
}

const sh = (cmd, args) => execFileSync(cmd, args, { encoding: 'utf8', timeout: 500, stdio: ['ignore', 'pipe', 'ignore'] })
function infer({ role, project, cwd, persona }) {
  let paneFailed = false
  // WT_ROLE / WT_PERSONA: set by a headless run (WP-307), which has no herdr pane token to read them from.
  role ||= process.env.WT_ROLE; persona ||= process.env.WT_PERSONA
  if ((!role || !project) && process.env.HERDR_PANE_ID) {
    try {
      const p = JSON.parse(sh('herdr', ['pane', 'get', process.env.HERDR_PANE_ID])).result?.pane ?? {}
      role ||= p.tokens?.role
      project ||= p.tokens?.project
      persona ||= p.tokens?.persona
      cwd ||= p.cwd
    } catch { paneFailed = true }
  }
  if (!project) {
    try { project = basename(dirname(sh('git', ['-C', cwd || process.cwd(), 'rev-parse', '--path-format=absolute', '--git-common-dir']).trim())) } catch {}
  }
  return { role, project, persona, cwd, paneFailed }
}

function flags(argv) {
  const o = { _: [] }
  for (let i = 0; i < argv.length; i++) {
    if (/^--(role|project|cwd|scope|persona|session|limit)$/.test(argv[i])) o[argv[i].slice(2)] = argv[++i]
    else if (argv[i] === '--json') o.json = true
    else if (argv[i] === '--strict') o.strict = true
    else if (argv[i] === '--strict-pane') o.strictPane = true
    else o._.push(argv[i])
  }
  return o
}

// ---- agent-maintained entries ----
const PENDING = join(HOME, 'pending')
const atomic = (f, text) => { mkdirSync(dirname(f), { recursive: true }); const t = `${f}.${process.pid}.tmp`; writeFileSync(t, text); renameSync(t, f) }
const norm = (t) => t.toLowerCase().replace(/[^\p{L}\p{N}]+/gu, ' ').trim()
const today = () => new Date().toISOString().slice(0, 10)
function author() {
  const pane = process.env.HERDR_PANE_ID
  if (!pane) return process.env.USER || 'unknown'
  try { return JSON.parse(sh('herdr', ['agent', 'list'])).result.agents.find((a) => a.pane_id === pane)?.name || pane } catch { return pane }
}
// Every scope file present: [{scope, name, file}].
function files() {
  const out = [{ scope: 'global', name: null, file: file('global') }]
  for (const [scope, dir] of [['role', 'roles'], ['project', 'projects']])
    try { for (const f of readdirSync(join(HOME, dir))) if (f.endsWith('.md') && NAME.test(f.slice(0, -3))) out.push({ scope, name: f.slice(0, -3), file: join(HOME, dir, f) }) } catch {}
  return out
}
const attrs = (t) => Object.fromEntries(t.split(/\s+/).filter(Boolean).map((kv) => kv.split('=')))
function entries() {
  const out = []
  for (const f of files()) for (const line of read(f.file).split('\n')) {
    const m = line.match(TRAILER)
    if (m) {
      const a = attrs(m[1]), t = tagsOf(strip(line).replace(/^\s*[-*]\s*/, ''))
      out.push({ ...f, id: a.id, by: a.by, at: a.at, text: t.text, ...(tagStr(t.tags) ? { tags: t.tags } : {}) })
    }
  }
  return out
}
function pending() {
  try { return readdirSync(PENDING).filter((f) => f.endsWith('.json')).map((f) => { try { return { ...JSON.parse(readFileSync(join(PENDING, f), 'utf8')), scope: 'global', pending: true } } catch { return null } }).filter(Boolean) } catch { return [] }
}
const line = (e) => `- ${tagStr(e.tags) ? tagStr(e.tags) + ' ' : ''}${e.text} <!-- wtm:id=${e.id} by=${e.by} at=${e.at} -->`
function append(f, e) {
  const cur = read(f)
  atomic(f, `${cur ? cur + '\n' : ''}${line(e)}\n`)
}
// Near-identical: same words ignoring case and punctuation, in the target file (any line) or pending.
// Same words AND same tags (the same rule for two roles is two entries). extra: [{text, tags}] (pending proposals).
const dup = (f, text, tags = {}, extra = []) => [...read(f).split('\n').map((l) => tagsOf(strip(l).replace(/^\s*[-*]\s*/, ''))).map((t) => ({ text: t.text, tags: t.tags })), ...extra]
  .some((l) => norm(l.text) === norm(text) && sameTags(l.tags, tags))

// Jev near-duplicate / conflict check (WT_JEV_MEMORY_DUP, default on): prints what it found; --strict refuses.
// Any failure (no pack, no key, timeout) → no check, as before.
async function jevDup(text, existing, strict) {
  if (!existing.length) return
  const { memoryDup, loadTypesafe } = await import('./jev-memory.mjs')
  const ts = await loadTypesafe()
  if (!ts?.enabled('memory_dup', true)) return
  const list = existing.slice(-40)
  const state = { note: text, existing: list }
  const a = await ts.judge('memory_dup', state, memoryDup.questions(state), { pick: (x) => memoryDup.decide(x).some((c) => c !== 'unrelated') })
  if (!a) return
  const cls = memoryDup.decide(a)
  const hits = (c) => list.filter((_, i) => cls[i] === c)
  for (const e of hits('duplicate')) console.log(`similar to: ${e}`)
  for (const e of hits('conflicts')) console.log(`conflicts with: ${e}`)
  if (strict && (hits('duplicate').length || hits('conflicts').length)) throw new Error('remember: refused (--strict): similar or conflicting entry exists')
}

async function remember(o) {
  const text = o._.join(' ').replace(/\s+/g, ' ').trim()
  if (!text) throw new Error('remember: a note is required')
  if (text.includes('<!--') || text.length > 500) throw new Error('remember: one line, up to 500 chars, no HTML comments')
  const { role, project } = infer(o)
  const scope = o.scope || (project ? 'project' : role ? 'role' : null)
  if (!['role', 'project', 'global'].includes(scope)) throw new Error('remember: --scope role|project|global (none inferable)')
  const name = scope === 'role' ? role : scope === 'project' ? project : null
  if (scope !== 'global' && !name) throw new Error(`remember: no ${scope} inferable; pass --${scope}`)
  const f = file(scope, name)
  // WP-369: an explicit --role/--project that does not select the file becomes a line tag (it used to be ignored).
  const tags = {}
  if (o.role && scope !== 'role') tags.role = [o.role]
  if (o.project && scope !== 'project') tags.project = [o.project]
  for (const [k, v] of Object.entries(tags)) if (!NAME.test(v[0])) throw new Error(`remember: bad ${k} name: ${v[0]}`)
  const e = { id: randomBytes(3).toString('hex'), by: author().replace(/\s+/g, '_'), at: today(), text, ...(tagStr(tags) ? { tags } : {}) }
  const lines = (g) => read(f).split('\n').map((l) => strip(l).replace(/^\s*[-*]\s*/, '')).filter((l) => l.trim()).concat(g)
  const pend = scope === 'global' ? pending() : []
  // Before either exact-dup branch, so global (proposed) and scoped remembers both get it.
  if (!dup(f, text, tags, pend)) await jevDup(text, lines(pend.map((p) => p.text)), o.strict)
  if (scope === 'global') {
    if (dup(f, text, tags, pending())) return console.log('already remembered (global)')
    atomic(join(PENDING, `${e.id}.json`), JSON.stringify(e, null, 2) + '\n')
    return console.log(`proposed (awaiting approval) ${e.id}: ${text}`)
  }
  if (dup(f, text, tags)) return console.log(`already remembered (${scope} ${name})`)
  append(f, e)
  console.log(`remembered (${scope} ${name}) ${e.id}: ${text}`)
}
const ID = /^[0-9a-f]{6}$/
function forget(id) {
  if (!ID.test(id ?? '')) throw new Error('bad id')
  for (const f of files()) {
    const lines = read(f.file).split('\n')
    const keep = lines.filter((l) => attrs(l.match(TRAILER)?.[1] ?? '').id !== id)
    if (keep.length !== lines.length) { atomic(f.file, keep.join('\n').trim() ? keep.join('\n').trimEnd() + '\n' : ''); return console.log(`forgot ${id}`) }
  }
  try { unlinkSync(join(PENDING, `${id}.json`)); return console.log(`rejected ${id}`) } catch {}
  throw new Error(`no entry ${id}`)
}
function accept(id) {
  if (!ID.test(id ?? '')) throw new Error('bad id')
  const p = join(PENDING, `${id}.json`)
  const e = JSON.parse(readFileSync(p, 'utf8'))
  if (!dup(file('global'), e.text, e.tags)) append(file('global'), e)
  unlinkSync(p)
  console.log(`accepted ${id}: ${e.text}`)
}

// ---- WP-235: per-prompt recall (keywords only, no LLM) ----
const STOP = new Set('about after again also because been before being could does doing done from have here into just like make more most much only other over please should some such than that their them then there these they this those very want what when where which while will with would your'.split(' '))
const words = (t) => new Set(norm(t).split(' ').filter((w) => w.length >= 4 && !STOP.has(w)))
// Entries of this agent's scopes (global, its role, its project) that share a word with the prompt, best first,
// minus the ids already recalled in this session (state in ~/.cache/wt-memory, cleared by SessionStart's inject).
function recall(prompt, o) {
  const { role, project, persona } = infer(o)
  const seen = join(process.env.WT_MEMORY_CACHE || join(homedir(), '.cache', 'wt-memory'), `${String(o.session ?? 'none').replace(/[^\w-]/g, '_')}.recalled`)
  const shown = new Set(read(seen).split('\n'))
  const pw = words(prompt.slice(0, 4000))
  const hits = entries().filter((e) => e.id && !shown.has(e.id) && (e.scope === 'global' || (e.scope === 'role' && e.name === role) || (e.scope === 'project' && e.name === project)) && tagsMatch(e.tags ?? {}, { role, persona, project }))
    .map((e) => ({ e, n: [...words(e.text)].filter((w) => pw.has(w)).length })).filter((x) => x.n > 0)
    .sort((a, b) => b.n - a.n).slice(0, Math.min(Number(o.limit) || 5, 5)).map((x) => x.e)
  if (!hits.length) return ''
  mkdirSync(dirname(seen), { recursive: true })
  appendFileSync(seen, hits.map((e) => e.id + '\n').join(''))
  const log = process.env.WT_MEMORY_READS || join(homedir(), '.local', 'share', 'wt-memory', 'reads.jsonl')
  mkdirSync(dirname(log), { recursive: true })
  appendFileSync(log, JSON.stringify({ at: new Date().toISOString(), session: o.session ?? null, kind: 'recall', ids: hits.map((e) => e.id) }) + '\n')
  return hits.map((e) => `- ${e.text}`).join('\n')
}

{
  const [cmd, ...rest] = process.argv.slice(2)
  if (cmd === 'context' || cmd === 'hash') {
    let out = ''
    try {
      const o = flags(rest), i = infer(o)
      if (cmd === 'context' && o.strictPane && i.paneFailed) process.exit(75) // WP-369: a lost pane lookup is not a preference change
      out = await merge(i)
    } catch {}
    if (cmd === 'hash') console.log(createHash('sha256').update(out).digest('hex').slice(0, 16))
    else if (out) console.log(out)
  } else if (cmd === 'recall') { // like context: never fails loudly
    try { const o = flags(rest); const out = recall(o._.join(' '), o); if (out) console.log(out) } catch {}
  } else if (['remember', 'forget', 'accept', 'reject', 'list'].includes(cmd)) {
    try {
      const o = flags(rest)
      if (cmd === 'remember') await remember(o)
      else if (cmd === 'forget' || cmd === 'reject') forget(o._[0])
      else if (cmd === 'accept') accept(o._[0])
      else {
        const all = [...entries(), ...pending()].filter((e) => !o.scope || e.scope === o.scope)
        if (o.json) console.log(JSON.stringify(all.map(({ file: _, ...e }) => e)))
        else for (const e of all) console.log(`${e.id}  ${e.pending ? 'global (pending)' : e.scope + (e.name ? ' ' + e.name : '')}  ${e.by} ${e.at}  ${tagStr(e.tags) ? tagStr(e.tags) + ' ' : ''}${e.text}`)
      }
    } catch (e) { console.error(e.message); process.exit(1) }
  } else if (cmd === 'path') {
    try { console.log(rest[0] ? file(rest[0], rest[1]) : HOME) } catch (e) { console.error(e.message); process.exit(2) }
  } else {
    console.error(readFileSync(new URL(import.meta.url), 'utf8').split('\n').slice(2, 8).map((l) => l.replace(/^\/\/ ?/, '')).join('\n'))
    process.exit(2)
  }
}
