#!/usr/bin/env node
// WP-378: the fake `hc`. Replays real output recorded by ../hc-record.mjs from ../fixtures/hc/<verb>.json.
// Not a simulator: it keeps no terminals. A test says which recorded case each verb answers with.
//   FAKE_HC_CASES  JSON {"<verb>": "<case>" | ["<case>", ...] | {exit, stdout, stderr}}  (an array answers call 1, 2, ..., the last repeats)
//   FAKE_HC_LOG    file; one JSON line per call {args, stdin, env:{HC_TERMINAL_ID,HC_SCOPE}}
//   FAKE_HC_STATE  dir for the per-verb call counters (default: dirname of FAKE_HC_LOG, else os tmp)
// verb = args[0]; `server status` is "server-status"; `connect` answers the JSON-RPC method on stdin from connect.json
// (case "<method>" unless FAKE_HC_CASES names one for "connect"). An unrecorded verb or case exits 99.
import { appendFileSync, existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs'
import { tmpdir } from 'node:os'
import { dirname, join } from 'node:path'
import { fileURLToPath } from 'node:url'

const FIX = join(dirname(fileURLToPath(import.meta.url)), '..', 'fixtures', 'hc')
const args = process.argv.slice(2)
const stdin = args[0] === 'connect' ? readFileSync(0, 'utf8') : ''
const fail = (m) => { process.stderr.write(`fake-hc: ${m}\n`); process.exit(99) }
if (process.env.FAKE_HC_LOG) appendFileSync(process.env.FAKE_HC_LOG, JSON.stringify({ args, stdin: stdin || undefined, env: { HC_TERMINAL_ID: process.env.HC_TERMINAL_ID, HC_SCOPE: process.env.HC_SCOPE } }) + '\n')
const verb = args[0] === 'server' ? `server-${args[1]}` : args[0]
const cases = JSON.parse(process.env.FAKE_HC_CASES || '{}')
let want = cases[verb]
let rpcId = 1, method = null
if (verb === 'connect') {
  try { const q = JSON.parse(stdin.split('\n')[0]); rpcId = q.id; method = q.method } catch { fail('connect: no JSON-RPC request on stdin') }
}
const pick = (v) => {
  if (!Array.isArray(v)) return v
  const dir = process.env.FAKE_HC_STATE || (process.env.FAKE_HC_LOG ? dirname(process.env.FAKE_HC_LOG) : tmpdir())
  mkdirSync(dir, { recursive: true })
  const f = join(dir, `.fake-hc-n-${verb}`)
  const n = existsSync(f) ? Number(readFileSync(f, 'utf8')) : 0
  writeFileSync(f, String(n + 1))
  return v[Math.min(n, v.length - 1)]
}
want = pick(want)
let out
if (want && typeof want === 'object') out = want
else {
  const f = join(FIX, `${verb}.json`)
  if (!existsSync(f)) fail(`no fixture for verb "${verb}"`)
  const doc = JSON.parse(readFileSync(f, 'utf8'))
  const name = want ?? method ?? Object.keys(doc.cases)[0]
  out = doc.cases[name]
  if (!out) fail(`no case "${name}" in ${verb}.json (have: ${Object.keys(doc.cases).join(', ')})`)
}
let stdout = out.stdout ?? ''
if (verb === 'connect') { try { const o = JSON.parse(stdout); o.id = rpcId; stdout = JSON.stringify(o) + '\n' } catch {} }
process.stdout.write(stdout)
process.stderr.write(out.stderr ?? '')
process.exit(out.exit ?? 0)
