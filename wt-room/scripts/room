#!/bin/sh
# room — talk in Herdr Dash chat rooms from inside an agent pane. POSIX sh + curl, no deps.
#   room list
#   room read <slug> [--since N]
#   room post <slug> "text"          (@name addresses someone; agents cannot @all)
# Identity: the pane herdr runs you in ($HERDR_PANE_ID); the server rejects unknown panes.
set -eu
API=${HERDR_DASH_URL:-http://127.0.0.1:7777}
die() { echo "room: $*" >&2; exit 1; }
esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | awk 'BEGIN{ORS=""} NR>1{print "\\n"} {gsub(/\t/,"\\t"); print}'; }
call() { curl -sS --fail-with-body -H "x-herdr-pane: ${HERDR_PANE_ID:-}" "$@"; }
cmd=${1:-}; [ $# -gt 0 ] && shift
case "$cmd" in
  list) call "$API/api/rooms?format=text" ;;
  read)
    [ $# -ge 1 ] || die "usage: room read <slug> [--since N]"
    slug=$1; since=0
    [ "${2:-}" = "--since" ] && since=${3:-0}
    call "$API/api/rooms/$slug/messages?format=text&since=$since" ;;
  post)
    [ $# -ge 2 ] || die 'usage: room post <slug> "text"'
    [ -n "${HERDR_PANE_ID:-}" ] || die "not inside a herdr pane (HERDR_PANE_ID is unset)"
    call -X POST -H 'content-type: application/json' --data "{\"text\":\"$(esc "$2")\"}" "$API/api/rooms/$1/messages" >/dev/null
    echo "posted to #$1" ;;
  *) die 'usage: room list | room read <slug> [--since N] | room post <slug> "text"' ;;
esac
